# Life OS: everything is set automatically on Vercel. These are only for local dev.
# The one login password (no username).
APP_PASSWORD=change-me
# Postgres. On Vercel this comes from the Neon integration (life-os-db).
DATABASE_URL=postgres://postgres@localhost/lifeos
# Optional: signs login cookies. Defaults to a hash of APP_PASSWORD + DATABASE_URL.
# SESSION_SECRET=
# Optional: private Vercel Blob store (life-os-private). Empty = files saved to ./.local-files
# BLOB_READ_WRITE_TOKEN=
